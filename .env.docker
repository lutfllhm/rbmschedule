# Docker Environment Configuration untuk RBM Schedule
# Copy file ini menjadi .env sebelum deploy

# Application Settings
APP_ENV=production
DEBUG_MODE=false

# Database Configuration
# PENTING: Ganti password ini dengan yang lebih aman!
DB_ROOT_PASS=change_root_password_here_123!
DB_HOST=rbm-db
DB_PORT=3306
DB_NAME=rbm_schedule
DB_USER=rbm_user
DB_PASS=change_db_password_here_456!

# Web Server Port (ganti jika port sudah digunakan)
WEB_PORT=8090

# MySQL Port External (untuk akses dari host)
DB_PORT_EXTERNAL=3307

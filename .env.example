# ===========================================
# RBM Schedule - Environment Configuration
# ===========================================

# Application Settings
APP_ENV=production
DEBUG_MODE=false

# Database Configuration
DB_ROOT_PASS=YourSecureRootPassword123!
DB_HOST=rbm-db
DB_PORT=3306
DB_NAME=rbm_schedule
DB_USER=rbm_user
DB_PASS=YourSecurePassword123!

# Port Configuration
# PENTING: Sesuaikan port ini dengan port yang tersedia di server Anda
# Web Server Port (akses aplikasi dari browser)
WEB_PORT=8090

# MySQL Port External (untuk akses MySQL dari host/tools eksternal seperti MySQL Workbench)
# Port internal MySQL tetap 3306, ini adalah port mapping ke host
# Gunakan port yang belum terpakai di server Anda
DB_PORT_EXTERNAL=3308

# ===========================================
# CATATAN PENTING:
# 1. Ganti semua password dengan password yang kuat di production!
# 2. Pastikan port WEB_PORT dan DB_PORT_EXTERNAL tidak konflik dengan aplikasi lain
# 3. Jangan commit file .env yang berisi password asli ke repository
# ===========================================
